{
  "name": "@gardendesk/desktop",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import tsx run-tauri.ts build",
    "build:sidecar": "node --import tsx build-sidecar.ts",
    "check:sidecar": "node --import tsx build-sidecar.ts --check",
    "clean:model-copies": "node --import tsx clean-model-copies.ts",
    "clean:development-model": "node --import tsx clean-development-model.ts",
    "prepare:dev": "node --import tsx prepare-dev.ts",
    "start:dev": "node --import tsx start-dev.ts",
    "dev": "vite --port 1420 --strictPort",
    "build:web": "vite build",
    "tauri": "node --import tsx run-tauri.ts"
  },
  "dependencies": {
    "@gardendesk/shared": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "flag-icons": "7.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6",
    "vite": "8.3.4"
  }
}
